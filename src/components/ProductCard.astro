---
const { product } = Astro.props;
---
<article class="card">
  <a class="card-media" href={`/products/${product.slug}`}><img src={product.image} alt={`${product.brand} ${product.name}`} loading="lazy" width="700" height="700"/><span class="card-badge">คั่วระดับ {product.roast}</span></a>
  <div class="card-body">
    <div class="eyebrow">{product.brand}</div>
    <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
    <p>{product.summary}</p>
    <div>{product.bestFor.slice(0,2).map((x:string)=><span class="tag">{x}</span>)}</div>
    <div class="card-meta"><span class="score">{product.score}/5</span><a class="text-link" href={`/products/${product.slug}`}>ดูรายละเอียด <span aria-hidden="true">→</span></a></div>
  </div>
</article>
