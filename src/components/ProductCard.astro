---
const { product } = Astro.props;
---
<article class="card">
  <a href={`/products/${product.slug}`}><img src={product.image} alt={`${product.brand} ${product.name}`} loading="lazy" /></a>
  <div class="card-body">
    <div class="eyebrow">{product.brand}</div>
    <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
    <p>{product.summary}</p>
    <div class="score">{product.score}/5</div>
    <div>{product.bestFor.slice(0,2).map((x:string)=><span class="tag">{x}</span>)}</div>
  </div>
</article>
