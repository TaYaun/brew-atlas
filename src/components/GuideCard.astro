---
const { guide } = Astro.props;
---
<article class="story-card">
  <div class="eyebrow">{guide.category} · {guide.readTime}</div>
  <h3><a href={`/guides/${guide.slug}`}>{guide.title}</a></h3>
  <p>{guide.description}</p>
  <a class="text-link" href={`/guides/${guide.slug}`}>Read guide <span aria-hidden="true">→</span></a>
</article>
