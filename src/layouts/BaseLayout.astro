---
const { title = 'Brew Atlas', description = 'Explore Coffee. Find Your Cup.', image = '/og-default.svg', type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=Playfair+Display:wght@600;700&display=swap');
      :root{--ink:#2B1F14;--coffee:#8B5E3C;--cream:#F8F4EC;--paper:#fffdf9;--muted:#746961;--line:#ded3c8;--accent:#8B5E3C;--green:#2F4E36;--cherry:#7A2E2E;--latte:#D4B483;--shadow:0 18px 55px rgba(43,31,20,.09)}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #d79a68;outline-offset:3px}img{max-width:100%;display:block}.wrap{width:min(1180px,92vw);margin:auto}.nav{display:flex;justify-content:space-between;align-items:center;min-height:74px;border-bottom:1px solid var(--line)}.brand{font-family:Georgia,serif;font-size:1.4rem;letter-spacing:.1em;font-weight:700}.brand small{display:block;font:500 .58rem/1.1 Inter,sans-serif;letter-spacing:.17em;color:var(--muted)}.menu{display:flex;gap:26px;font-size:.94rem}.menu a:hover,.text-link:hover{color:var(--accent)}.hero{padding:98px 0 70px;background:radial-gradient(circle at 80% 10%,#ead7c3 0,transparent 30%),linear-gradient(180deg,#f4ede4,transparent)}.eyebrow{text-transform:uppercase;letter-spacing:.16em;color:var(--accent);font-size:.75rem;font-weight:800}.hero h1,.page-title{font-family:Georgia,serif;font-size:clamp(2.7rem,6vw,6rem);line-height:.98;margin:.18em 0}.hero p,.lede{max-width:720px;color:var(--muted);font-size:1.12rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.card,.story-card{border:1px solid var(--line);background:#fff;border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.card:hover,.story-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.card img{aspect-ratio:1/1;object-fit:cover;background:#f4f0eb}.card-body,.story-card{padding:20px}.card-body{display:flex;flex:1;flex-direction:column}.card-body h3,.story-card h3{font-family:Georgia,serif;font-size:1.25rem;line-height:1.25;margin:.4rem 0}.card-body p,.story-card p{color:var(--muted)}.tag{display:inline-block;padding:4px 9px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.76rem;margin:2px}.btn{display:inline-block;background:var(--ink);color:#fff;padding:12px 17px;border-radius:10px;font-weight:750;border:1px solid var(--ink)}.btn.secondary{color:var(--ink);background:transparent}.text-link{font-weight:750;color:var(--coffee);margin-top:auto}.section{padding:64px 0}.section.alt{background:#f7f1ea}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:25px}.section h2,.prose h2{font-family:Georgia,serif;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.15;margin:.2em 0}.footer{border-top:1px solid var(--line);padding:40px 0;color:var(--muted);font-size:.88rem}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:28px}.product{display:grid;grid-template-columns:1.02fr .98fr;gap:48px;align-items:start}.product img{border-radius:20px;border:1px solid var(--line)}.score{font:700 1.1rem Georgia,serif;color:var(--green)}.notice{background:var(--cream);padding:14px 16px;border-radius:12px;color:var(--muted);font-size:.88rem}.prose{max-width:780px}.prose h1{font-family:Georgia,serif;font-size:clamp(2.4rem,5vw,4.3rem);line-height:1.05}.prose h2{margin-top:1.8em}.prose li{margin:.45em 0}.filterbar{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0}.filterbar input,.filterbar select{font:inherit;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:white}.filterbar input{flex:1;min-width:220px}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:20}.mobile-toggle{display:none;background:none;border:0;font-size:1.5rem}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:1fr 1fr}.product{grid-template-columns:1fr}.menu{display:none}.mobile-toggle{display:block}.menu.open{display:flex;position:absolute;top:74px;left:0;right:0;background:var(--paper);padding:20px 4vw;z-index:10;flex-direction:column;border-bottom:1px solid var(--line)}}@media(max-width:600px){.grid,.story-grid,.footer-grid{grid-template-columns:1fr}.hero{padding-top:62px}.hero h1{font-size:3.2rem}.section{padding:48px 0}.section-head{align-items:start;flex-direction:column}}
      .brand,.hero h1,.page-title,.card-body h3,.story-card h3,.section h2,.prose h1,.prose h2,.score{font-family:'Playfair Display',Georgia,serif}.hero.visual{min-height:72vh;display:grid;align-items:end;background:linear-gradient(90deg,rgba(24,15,9,.8),rgba(24,15,9,.08)),url('/brand/brew-atlas-hero.webp') center/cover}.hero.visual .eyebrow,.hero.visual h1,.hero.visual p{color:#fff}.hero.visual .btn{background:var(--cream);color:var(--ink)}.hero.visual .btn.secondary{background:transparent;color:#fff;border-color:#fff}@media(max-width:600px){.hero.visual{min-height:64vh;background-position:44% center}}
      .hero.visual{background-image:linear-gradient(90deg,rgba(24,15,9,.78),rgba(24,15,9,.05)),url('/brand/brew-atlas-hero.webp')}
    </style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="wrap nav"><a class="brand" href="/">BREW ATLAS<small>EXPLORE COFFEE. FIND YOUR CUP.</small></a><button class="mobile-toggle" aria-label="Open menu" aria-expanded="false">☰</button><nav class="menu" aria-label="Main navigation"><a href="/reviews">Reviews</a><a href="/guides">Brew Guides</a><a href="/products">Coffee Picks</a><a href="/about">About</a></nav></header>
    <main id="content"><slot /></main>
    <footer class="footer"><div class="wrap footer-grid"><div><strong>BREW ATLAS</strong><p>Independent coffee discovery and confident recommendations.</p></div><div><strong>Explore</strong><p><a href="/products">Coffee Picks</a><br/><a href="/reviews">Reviews</a><br/><a href="/guides">Brew Guides</a></p></div><div><strong>Editorial</strong><p><a href="/about">About & disclosure</a><br/><a href="/privacy">Privacy</a></p></div></div></footer>
    <script is:inline>document.querySelector('.mobile-toggle')?.addEventListener('click',e=>{const b=e.currentTarget,n=document.querySelector('.menu');n?.classList.toggle('open');b.setAttribute('aria-expanded',String(n?.classList.contains('open')))})</script>
  </body>
</html>
