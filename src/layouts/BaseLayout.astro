---
const { title = 'Brew Atlas TH', description = 'Explore Coffee. Find Your Cup.', image = '/brand/brew-atlas-og.jpg', type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#24170f"/>
  <title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image, Astro.site)}/><meta name="twitter:card" content="summary_large_image"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>}
  {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+Thai:wght@600;700&family=Playfair+Display:wght@600;700&display=swap');
    :root{--espresso:#24170f;--coffee:#8b5e3c;--latte:#d4b483;--forest:#2f4e36;--cherry:#7a2e2e;--cream:#f8f4ec;--paper:#fffdf8;--muted:#70655d;--line:#e3d8ca;--shadow:0 24px 65px rgba(36,23,15,.12);--serif:'Playfair Display','Noto Serif Thai',Georgia,serif;--sans:Inter,'Noto Sans Thai',system-ui,sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--espresso);font-family:var(--sans);line-height:1.65}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--latte);outline-offset:4px}img{max-width:100%;display:block}.wrap{width:min(1180px,92vw);margin:auto}
    .topline{background:var(--espresso);color:#e9d7be;text-align:center;padding:7px 4vw;font-size:.69rem;letter-spacing:.18em;text-transform:uppercase}.nav-shell{background:rgba(255,253,248,.95);position:sticky;top:0;z-index:15;border-bottom:1px solid rgba(139,94,60,.16);backdrop-filter:blur(16px)}.nav{display:flex;justify-content:space-between;align-items:center;min-height:82px}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:58px;height:58px;display:grid;place-items:center;border-radius:50%;overflow:hidden}.brand-mark img{width:100%;height:100%;object-fit:cover}.brand-copy{font:700 1.28rem/1 var(--serif);letter-spacing:.09em}.brand-copy small{display:block;font:600 .52rem/1.2 var(--sans);letter-spacing:.19em;color:var(--coffee);margin-top:6px}.menu{display:flex;align-items:center;gap:29px;font-size:.85rem;font-weight:600}.menu a{position:relative}.nav-cta{border:1px solid var(--espresso);padding:9px 14px}.mobile-toggle{display:none;background:none;border:0;font-size:1.5rem}
    .eyebrow{text-transform:uppercase;letter-spacing:.19em;color:var(--coffee);font-size:.68rem;font-weight:700}.page-title{font:700 clamp(2.7rem,6vw,5.4rem)/.98 var(--serif);margin:.18em 0}.lede{max-width:720px;color:var(--muted);font-size:1.08rem}.section{padding:82px 0}.section.alt{background:var(--cream)}.section.dark{background:var(--espresso);color:var(--cream)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:34px}.section h2,.prose h2{font:700 clamp(2rem,3.7vw,3.35rem)/1.08 var(--serif);margin:.2em 0}.section-intro{max-width:620px;color:var(--muted);margin:8px 0 0}
    .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.card{background:#fff;border:1px solid var(--line);border-radius:4px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}.card-media{position:relative;overflow:hidden;background:#f0e8dd;aspect-ratio:4/3}.card-media img{width:100%;height:100%;object-fit:contain;padding:8px;transition:transform .5s}.card:hover .card-media img{transform:scale(1.025)}.card-badge{position:absolute;top:13px;left:13px;background:rgba(255,253,248,.92);padding:6px 9px;font-size:.6rem;letter-spacing:.12em;text-transform:uppercase}.card-body{padding:16px 17px;display:flex;flex:1;flex-direction:column}.card-body h3,.story-card h3{font:700 1.16rem/1.23 var(--serif);margin:.42rem 0}.card-body p,.story-card p{color:var(--muted);font-size:.83rem}.card-meta{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:13px;margin-top:auto}.score{font:700 1rem var(--serif);color:var(--forest)}.tag{display:inline-block;padding:3px 8px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.68rem;margin:2px}
    .story-card{border-top:2px solid var(--coffee);background:#fff;min-height:255px;display:flex;flex-direction:column;overflow:hidden;transition:transform .2s}.story-card:hover{transform:translateY(-4px)}.guide-media{display:block;aspect-ratio:3/2;overflow:hidden}.guide-media img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.story-card:hover .guide-media img{transform:scale(1.025)}.guide-copy{padding:22px;display:flex;flex:1;flex-direction:column}.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--espresso);color:#fff;padding:12px 18px;border-radius:2px;font-weight:700;font-size:.83rem;border:1px solid var(--espresso)}.btn:hover{background:var(--coffee);border-color:var(--coffee)}.btn.secondary{color:var(--espresso);background:transparent}.text-link{font-weight:700;color:var(--coffee);margin-top:auto;font-size:.83rem}.actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:28px}
    .product{display:grid;grid-template-columns:1.02fr .98fr;gap:55px;align-items:start}.product>div:first-child{background:var(--cream);padding:22px}.product img{display:block;width:100%;aspect-ratio:1/1;object-fit:contain;border:1px solid var(--line);background:#fff}.notice,.callout{background:var(--cream);padding:14px 16px;border-left:3px solid var(--latte);color:var(--muted);font-size:.86rem}.prose{max-width:820px}.prose h1{font:700 clamp(2.5rem,5vw,4.7rem)/1.03 var(--serif)}.prose h2{margin-top:1.8em}.article-hero{width:100%;max-height:540px;object-fit:cover;margin:28px 0 34px}.article-meta{color:var(--coffee);font-size:.78rem;font-weight:700;letter-spacing:.08em}.toc{background:var(--cream);border:1px solid var(--line);padding:20px 24px;margin:26px 0}.toc strong{font-family:var(--serif)}.toc a{color:var(--coffee);text-decoration:underline;text-underline-offset:3px}.prose table{width:100%;border-collapse:collapse;margin:24px 0;font-size:.88rem}.prose th,.prose td{padding:12px;border:1px solid var(--line);text-align:left;vertical-align:top}.prose th{background:var(--cream)}.filterbar{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0}.filterbar input,.filterbar select{font:inherit;padding:13px 15px;border:1px solid var(--line);border-radius:2px;background:#fff}.filterbar input{flex:1;min-width:220px}
    .footer{background:#1c120c;color:#bcae9e;padding:62px 0 24px;font-size:.84rem}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:42px}.footer strong{color:var(--cream);font-family:var(--serif);font-size:1rem}.footer-brand{font:700 1.75rem var(--serif);letter-spacing:.08em;color:var(--cream)}.footer-bottom{border-top:1px solid rgba(255,255,255,.11);margin-top:42px;padding-top:20px;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:30}
    @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:1fr 1fr}.product{grid-template-columns:1fr;gap:30px}.product>div:first-child{width:min(100%,520px);justify-self:center}.menu{display:none}.mobile-toggle{display:block}.menu.open{display:flex;position:absolute;top:82px;left:0;right:0;background:var(--paper);padding:24px 4vw;z-index:10;flex-direction:column;align-items:flex-start;border-bottom:1px solid var(--line)}}
    @media(max-width:600px){.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.story-grid,.footer-grid{grid-template-columns:1fr}.grid .card{width:100%;min-width:0}.card-media{aspect-ratio:1/1}.card-media img{padding:4px}.card-body{padding:10px}.card-body h3{font-size:.9rem}.card-body p{display:none}.card-badge{top:7px;left:7px;padding:4px 6px;font-size:.48rem}.card-meta{padding-top:8px;font-size:.66rem}.score{font-size:.82rem}.product>div:first-child{width:min(82vw,340px);padding:10px}.product img{max-height:340px}.section{padding:48px 0}.section-head{align-items:start;flex-direction:column}.topline{font-size:.56rem}.brand-mark{width:38px;height:38px}.brand-copy{font-size:1.05rem}.brand-copy small{display:none}}
  </style>
</head>
<body>
  <a class="skip" href="#content">ข้ามไปยังเนื้อหา</a><div class="topline">เรื่องราวกาแฟ · คำแนะนำที่คัดสรรเพื่อคนไทย</div>
  <div class="nav-shell"><header class="wrap nav"><a class="brand" href="/" aria-label="หน้าแรก Brew Atlas TH"><span class="brand-mark"><img src="/brand/brew-atlas-approved-mark.webp" alt="" width="58" height="58"/></span><span class="brand-copy">BREW ATLAS TH<small>EXPLORE COFFEE. FIND YOUR CUP.</small></span></a><button class="mobile-toggle" aria-label="เปิดเมนู" aria-expanded="false">☰</button><nav class="menu" aria-label="เมนูหลัก"><a href="/reviews">รีวิวกาแฟ</a><a href="/guides">คู่มือชงกาแฟ</a><a href="/products">กาแฟแนะนำ</a><a href="/about">เรื่องของเรา</a><a class="nav-cta" href="/products">ค้นหากาแฟที่ใช่</a></nav></header></div>
  <main id="content"><slot/></main>
  <footer class="footer"><div class="wrap"><div class="footer-grid"><div><div class="footer-brand">BREW ATLAS TH</div><p>จากขุนเขาสู่ช่วงเวลาดี ๆ เราช่วยให้คนไทยค้นพบกาแฟที่ตรงกับรสนิยมและวิธีชงของตัวเอง</p></div><div><strong>สำรวจกาแฟ</strong><p><a href="/products">กาแฟแนะนำ</a><br/><a href="/reviews">รีวิวกาแฟ</a><br/><a href="/guides">คู่มือชงกาแฟ</a></p></div><div><strong>เกี่ยวกับเรา</strong><p><a href="/about">เรื่องของเราและการเปิดเผยข้อมูล</a><br/><a href="/privacy">นโยบายความเป็นส่วนตัว</a></p></div></div><div class="footer-bottom">Explore coffee. Find your cup. · © 2026 Brew Atlas TH</div></div></footer>
  <script is:inline>document.querySelector('.mobile-toggle')?.addEventListener('click',e=>{const b=e.currentTarget,n=document.querySelector('.menu');n?.classList.toggle('open');b.setAttribute('aria-expanded',String(n?.classList.contains('open')))})</script>
</body></html>
