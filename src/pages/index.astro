---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { activeProducts } from '../data/products';
import { guides } from '../data/guides';
---
<BaseLayout title="Brew Atlas TH — สำรวจโลกกาแฟ ค้นหาแก้วที่ใช่" description="คู่มือกาแฟ รีวิวที่มีบริบท และเมล็ดกาแฟคัดสรรสำหรับคนรักกาแฟชาวไทย">
  <section class="home-hero" aria-labelledby="hero-title">
    <img src="/brand/brew-atlas-hero.webp" alt="Brew Atlas ท่ามกลางหุบเขากาแฟ พร้อมคำขวัญ Explore Coffee. Find Your Cup." width="1536" height="1024" fetchpriority="high"/>
    <h1 id="hero-title" class="sr-only">Brew Atlas TH — สำรวจโลกกาแฟ ค้นหาแก้วที่ใช่</h1>
    <div class="hero-actions"><a class="btn hero-primary" href="/products">เลือกดูกาแฟแนะนำ</a><a class="btn hero-secondary" href="/guides">อ่านคู่มือกาแฟ</a></div>
  </section>
  <section class="thai-slogan" aria-label="สโลแกน Brew Atlas TH"><div class="wrap"><span>BREW ATLAS TH</span><p>“สำรวจโลกของกาแฟ<br class="slogan-break"/> ค้นหาแก้วที่ใช่สำหรับคุณ”</p><i aria-hidden="true">◆</i></div></section>
  <section class="manifesto"><div class="wrap manifesto-grid"><div class="eyebrow">มุมมองของเรา</div><blockquote>“กาแฟไม่ใช่แค่เครื่องดื่ม แต่เป็นการเดินทางผ่านผู้คน สถานที่ และช่วงเวลาดี ๆ ในทุกวัน”</blockquote><p>เราแปลรายละเอียดบนฉลากและภาษาการชิมให้กลายเป็นคำแนะนำที่ชัดเจน เพื่อให้คนไทยเลือกกาแฟได้อย่างมั่นใจ</p></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">คอลเลกชันแนะนำ</div><h2>กาแฟ 18 รายการที่น่าลอง</h2><p class="section-intro">แสดงครบทุกผลิตภัณฑ์ ตั้งแต่กาแฟเอธิโอเปียโทนดอกไม้ กาแฟไทยจากแหล่งปลูก ไปจนถึง House Blend สำหรับ Modern Espresso</p></div><a class="text-link" href="/products">เปรียบเทียบทั้งหมด →</a></div><div class="grid">{activeProducts.map(product => <ProductCard product={product}/>)}</div></div></section>
  <section class="journey section dark"><div class="wrap"><div class="eyebrow">ค้นหาทิศทางรสชาติ</div><h2>เริ่มจากกาแฟแก้วที่คุณชอบ</h2><div class="journey-grid"><a href="/products" class="journey-card"><span>01</span><h3>สดใสและหอมละมุน</h3><p>โทนผลไม้ ดอกไม้ และรสชาติใสสะอาดสำหรับสาย Pour Over</p></a><a href="/products" class="journey-card"><span>02</span><h3>หวานและสมดุล</h3><p>โทนคาราเมล ดื่มง่าย เหมาะกับกาแฟประจำวัน</p></a><a href="/products" class="journey-card"><span>03</span><h3>เข้มลึกและหนักแน่น</h3><p>บอดี้และช็อกโกแลตสำหรับ Espresso และกาแฟนม</p></a></div></div></section>
  <section class="section alt"><div class="wrap"><div class="section-head"><div><div class="eyebrow">บันทึกจาก Brew Atlas TH</div><h2>ชงกาแฟทุกถุงให้อร่อยขึ้น</h2><p class="section-intro">ความรู้ที่นำไปใช้ได้จริง อธิบายชัด และทำซ้ำได้ในครัวของคุณ</p></div><a class="text-link" href="/guides">ดูคู่มือทั้งหมด →</a></div><div class="story-grid">{guides.slice(0,3).map(guide => <GuideCard guide={guide}/>)}</div></div></section>
  <section class="affiliate-note"><div class="wrap"><span>คัดเลือกอย่างอิสระ</span><p>เราเลือกสินค้าโดยพิจารณาความเหมาะสมและประโยชน์ต่อผู้อ่าน ลิงก์ร้านค้าบางรายการอาจสร้างค่าคอมมิชชันแก่ Brew Atlas TH โดยไม่ทำให้ราคาที่คุณจ่ายเพิ่มขึ้น</p><a href="/about">หลักเกณฑ์ของเรา →</a></div></section>
</BaseLayout>
<style>
  .home-hero{position:relative;overflow:hidden;background:var(--espresso);isolation:isolate}.home-hero>img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.hero-actions{position:absolute;z-index:2;left:50%;bottom:4.5%;transform:translateX(-50%);display:flex;gap:10px;padding:8px;background:rgba(43,31,20,.78);border:1px solid rgba(212,180,131,.55);backdrop-filter:blur(10px)}.hero-actions .btn{white-space:nowrap}.hero-primary{background:var(--latte);border-color:var(--latte);color:var(--espresso)}.hero-secondary{color:var(--cream);border-color:rgba(248,244,236,.55)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .thai-slogan{position:relative;background:var(--espresso);color:var(--cream);text-align:center;padding:42px 0 46px;border-top:1px solid rgba(212,180,131,.25);border-bottom:1px solid rgba(212,180,131,.25)}.thai-slogan .wrap{display:grid;justify-items:center;gap:10px}.thai-slogan span{color:var(--latte);font:.63rem var(--sans);letter-spacing:.28em}.thai-slogan p{margin:0;font:600 clamp(1.65rem,3.2vw,3rem)/1.35 'Noto Serif Thai',var(--serif);letter-spacing:.01em}.thai-slogan i{color:var(--latte);font-size:.62rem;margin-top:4px}.slogan-break{display:none}
  .manifesto{position:relative;background:linear-gradient(90deg,rgba(239,227,211,.97),rgba(239,227,211,.86)),url('/brand/brew-atlas-hero.webp') center 72%/cover;padding:55px 0}.manifesto-grid{display:grid;grid-template-columns:.45fr 1.65fr .75fr;gap:45px;align-items:center}.manifesto blockquote{font:600 clamp(1.55rem,2.7vw,2.5rem)/1.3 var(--serif);margin:0}.manifesto p{font-size:.85rem;color:var(--muted)}.journey{position:relative;background:linear-gradient(90deg,rgba(28,20,13,.94),rgba(28,20,13,.7)),url('/brand/brew-atlas-hero.webp') center 73%/cover fixed}.journey h2{color:#fff8ed}.journey .eyebrow{color:var(--latte)}.journey-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:38px;border-block:1px solid rgba(255,255,255,.24);background:rgba(32,23,16,.35);backdrop-filter:blur(5px)}.journey-card{padding:38px 30px;border-right:1px solid rgba(255,255,255,.16);transition:background .2s}.journey-card:last-child{border-right:0}.journey-card:hover{background:rgba(255,255,255,.08)}.journey-card>span{color:var(--latte);font-size:.67rem}.journey-card h3{font:600 1.65rem var(--serif);margin:42px 0 7px}.journey-card p{color:#d5c9ba;font-size:.85rem}.affiliate-note{background:#e4d0b7;padding:28px 0}.affiliate-note .wrap{display:grid;grid-template-columns:.7fr 2fr auto;align-items:center;gap:28px}.affiliate-note span{font:600 1rem var(--serif)}.affiliate-note p{font-size:.76rem;margin:0;color:#67594e}.affiliate-note a{font-size:.75rem;font-weight:700}
  @media(max-width:900px){.manifesto-grid{grid-template-columns:1fr}.journey-grid{grid-template-columns:1fr}.journey-card{border-right:0;border-bottom:1px solid rgba(255,255,255,.16)}.affiliate-note .wrap{grid-template-columns:1fr}}
  @media(max-width:600px){.home-hero>img{aspect-ratio:3/2;object-fit:cover}.hero-actions{position:static;transform:none;display:grid;grid-template-columns:1fr 1fr;background:var(--espresso);border:0;padding:12px}.hero-actions .btn{text-align:center;padding:11px 8px;font-size:.72rem}.thai-slogan{padding:32px 0 35px}.slogan-break{display:block}.manifesto{padding:42px 0}}
</style>
