---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { activeProducts } from '../../data/products';
---
<BaseLayout title="รีวิวกาแฟพร้อมบริบท | Brew Atlas TH" description="รีวิวกาแฟที่อธิบายระดับคั่ว รสชาติ วิธีชง และผู้ดื่มที่เหมาะสม"><section class="section"><div class="wrap"><div class="eyebrow">รีวิวอย่างอิสระ</div><h1 class="page-title">รีวิวที่ช่วยให้เลือกได้จริง</h1><p class="lede">ทุกรีวิวอธิบายทิศทางรสชาติ วิธีชงที่เหมาะ และข้อควรพิจารณา เพราะคะแนนเพียงอย่างเดียวไม่สามารถเล่าเรื่องกาแฟได้ครบ</p><div class="grid">{activeProducts.map(product => <ProductCard product={product} />)}</div></div></section></BaseLayout>
