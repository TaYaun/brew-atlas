---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
export function getStaticPaths(){ return products.filter(p=>p.status==='active').map(product=>({params:{slug:product.slug},props:{product}})); }
const { product } = Astro.props;
const schema = {'@context':'https://schema.org','@type':'Product',name:`${product.brand} ${product.name}`,image:new URL(product.image,Astro.site).href,description:product.summary,brand:{'@type':'Brand',name:product.brand},review:{'@type':'Review',author:{'@type':'Organization',name:'Brew Atlas TH',url:new URL('/',Astro.site).href},reviewRating:{'@type':'Rating',ratingValue:product.score,bestRating:5},reviewBody:product.verdict}};
---
<BaseLayout title={`${product.name} รีวิว | Brew Atlas TH`} description={product.summary} image={product.image} type="article" schema={schema}>
  <section class="section"><div class="wrap product"><div><img src={product.image} alt={`${product.brand} ${product.name}`} width="900" height="900" /></div><article><div class="eyebrow">{product.brand} · รีวิวกาแฟ</div><h1>{product.name}</h1><p class="score">{product.score}/5 · ความเห็นจาก Brew Atlas TH</p><p class="lede">{product.summary}</p><p><strong>ระดับคั่ว:</strong> {product.roast}<br/><strong>แหล่งปลูก:</strong> {product.origin}<br/><strong>ขนาดบรรจุ:</strong> {product.size}</p><p><strong>ทิศทางรสชาติ:</strong> {product.notes.join(' · ')}</p><p><strong>เหมาะสำหรับ:</strong> {product.bestFor.join(', ')}</p>{product.details?.length && <><h2>ข้อมูลจากหน้าร้าน</h2><dl class="product-facts">{product.details.map((item:{label:string;value:string}) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></>}<h2>มุมมองของเรา</h2><p>{product.verdict} โน้ตรสชาติเป็นแนวทาง ไม่ใช่สิ่งรับประกัน เพราะน้ำ เครื่องบด สูตรชง และความสดล้วนส่งผลต่อรสชาติในแก้ว</p><h2>เหมาะกับใคร?</h2><p>เลือกกาแฟรายการนี้หากคุณชอบโทน {product.notes.slice(0,2).join(' และ ').toLowerCase()} และมักชงด้วย {product.bestFor.slice(0,2).join(' หรือ ').toLowerCase()} โปรดตรวจสอบวันที่คั่ว ตัวเลือกการบด ราคา และสต็อกล่าสุดจากหน้าร้าน</p><div class="actions"><a class="btn" href={`/go/${product.slug}?utm_campaign=product-review`} rel="sponsored nofollow">ตรวจสอบราคาบน Shopee</a><a class="btn secondary" href="/products">เปรียบเทียบทั้งหมด</a></div><p class="notice">ลิงก์บางรายการเป็น Affiliate Link หากคุณสั่งซื้อผ่านลิงก์ Brew Atlas TH อาจได้รับค่าคอมมิชชันโดยไม่เพิ่มค่าใช้จ่ายของคุณ</p></article></div></section>
</BaseLayout>
