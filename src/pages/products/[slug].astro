---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
export function getStaticPaths(){ return products.filter(p=>p.status==='active').map(product=>({params:{slug:product.slug},props:{product}})); }
const { product } = Astro.props;
const schema = {'@context':'https://schema.org','@type':'Product',name:`${product.brand} ${product.name}`,image:new URL(product.image,Astro.site).href,description:product.summary,brand:{'@type':'Brand',name:product.brand},review:{'@type':'Review',author:{'@type':'Organization',name:'Brew Atlas'},reviewRating:{'@type':'Rating',ratingValue:product.score,bestRating:5},reviewBody:product.verdict}};
---
<BaseLayout title={`${product.name} Review | Brew Atlas`} description={product.summary} image={product.image} type="article" schema={schema}>
  <section class="section"><div class="wrap product"><div><img src={product.image} alt={`${product.brand} ${product.name}`} width="900" height="900" /></div><article><div class="eyebrow">{product.brand} · Coffee review</div><h1>{product.name}</h1><p class="score">{product.score}/5 · Brew Atlas verdict</p><p class="lede">{product.summary}</p><p><strong>Roast:</strong> {product.roast}<br/><strong>Origin:</strong> {product.origin}<br/><strong>Pack:</strong> {product.size}</p><p><strong>Flavor direction:</strong> {product.notes.join(' · ')}</p><p><strong>Best for:</strong> {product.bestFor.join(', ')}</p><h2>Our take</h2><p>{product.verdict} Flavor notes are a direction rather than a guarantee: water, grinder, recipe and freshness will shape the final cup.</p><h2>Who should buy it?</h2><p>Choose this coffee if you enjoy {product.notes.slice(0,2).join(' and ').toLowerCase()} profiles and usually brew {product.bestFor.slice(0,2).join(' or ').toLowerCase()}. Check the seller listing for the current roast date, grind choices, price and stock.</p><div class="actions"><a class="btn" href={`/go/${product.slug}?utm_campaign=product-review`} rel="sponsored nofollow">Check price on Shopee</a><a class="btn secondary" href="/products">Compare all picks</a></div><p class="notice">Some links are affiliate links. If you buy through them, Brew Atlas may earn a commission at no extra cost to you.</p></article></div></section>
</BaseLayout>
