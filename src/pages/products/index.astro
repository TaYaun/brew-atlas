---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { activeProducts } from '../../data/products';
---
<BaseLayout title="กาแฟแนะนำ 8 รายการ | Brew Atlas TH" description="เลือกดูกาแฟแนะนำ 8 รายการตามระดับคั่ว รสชาติ และวิธีชง"><section class="section"><div class="wrap"><div class="eyebrow">กาแฟแนะนำ</div><h1 class="page-title">ค้นหากาแฟถุงถัดไปของคุณ</h1><p class="lede">กรองคอลเลกชันตามระดับคั่ว หรือค้นหารสชาติและวิธีชงที่คุณชื่นชอบ</p><div class="filterbar"><input id="search" type="search" placeholder="ค้นหารสชาติ แบรนด์ หรือวิธีชง" aria-label="ค้นหากาแฟ"/><select id="roast" aria-label="กรองตามระดับคั่ว"><option value="">ทุกระดับคั่ว</option><option>Light</option><option>Medium</option><option>Dark</option></select></div><div class="grid" id="products">{activeProducts.map(product => <div data-product data-search={`${product.brand} ${product.name} ${product.notes.join(' ')} ${product.bestFor.join(' ')}`.toLowerCase()} data-roast={product.roast.toLowerCase()}><ProductCard product={product} /></div>)}</div><p id="empty" hidden>ไม่พบกาแฟที่ตรงกับตัวกรอง ลองค้นหาด้วยคำที่กว้างขึ้น</p></div></section><script is:inline>const q=document.querySelector('#search'),r=document.querySelector('#roast'),items=[...document.querySelectorAll('[data-product]')],empty=document.querySelector('#empty');function run(){let s=q.value.toLowerCase().trim(),v=r.value.toLowerCase(),shown=0;items.forEach(x=>{let ok=(!s||x.dataset.search.includes(s))&&(!v||x.dataset.roast.includes(v));x.hidden=!ok;if(ok)shown++});empty.hidden=shown!==0}q.addEventListener('input',run);r.addEventListener('change',run)</script></BaseLayout>
