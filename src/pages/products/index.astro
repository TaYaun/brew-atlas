---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { activeProducts } from '../../data/products';
---
<BaseLayout title="Coffee Picks: 8 Beans for Every Brew | Brew Atlas TH" description="Browse 8 Brew Atlas TH coffee recommendations by roast, flavor and brew style."><section class="section"><div class="wrap"><div class="eyebrow">Coffee Picks</div><h1 class="page-title">Find your next bag</h1><p class="lede">Filter the launch collection by roast or search for the flavors and brew methods you enjoy.</p><div class="filterbar"><input id="search" type="search" placeholder="Search flavor, brand or brew method" aria-label="Search coffee"/><select id="roast" aria-label="Filter by roast"><option value="">All roasts</option><option>Light</option><option>Medium</option><option>Dark</option></select></div><div class="grid" id="products">{activeProducts.map(product => <div data-product data-search={`${product.brand} ${product.name} ${product.notes.join(' ')} ${product.bestFor.join(' ')}`.toLowerCase()} data-roast={product.roast.toLowerCase()}><ProductCard product={product} /></div>)}</div><p id="empty" hidden>No coffee matches those filters. Try a broader search.</p></div></section><script is:inline>const q=document.querySelector('#search'),r=document.querySelector('#roast'),items=[...document.querySelectorAll('[data-product]')],empty=document.querySelector('#empty');function run(){let s=q.value.toLowerCase().trim(),v=r.value.toLowerCase(),shown=0;items.forEach(x=>{let ok=(!s||x.dataset.search.includes(s))&&(!v||x.dataset.roast.includes(v));x.hidden=!ok;if(ok)shown++});empty.hidden=shown!==0}q.addEventListener('input',run);r.addEventListener('change',run)</script></BaseLayout>
