---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activeProducts } from '../../data/products';

const title = 'กาแฟบราซิล Cerrado Jaguar คืออะไร? รสชาติและวิธีชง | Brew Atlas TH';
const description = 'รู้จักกาแฟ Brazil Cerrado Jaguar โทนช็อกโกแลตนม ถั่ว และครีมมี่ พร้อมข้อมูลแหล่งปลูก ระดับคั่ว และสูตรชง';
const image = '/guides/brazil-cerrado-jaguar.webp';
const product = activeProducts.find(item => item.slug === 'roast-lab-bkk-brazil-cerrado-jaguar');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'กาแฟบราซิล Cerrado Jaguar: กาแฟโทนช็อกโกแลตจากแหล่งปลูกสำคัญของบราซิล',
  description,
  image: new URL(image, Astro.site).href,
  datePublished: '2026-09-11',
  dateModified: '2026-09-11',
  inLanguage: 'th-TH',
  author: { '@type': 'Person', name: 'พี่หยวน — BREW ATLAS TH' },
  publisher: { '@type': 'Organization', name: 'BREW ATLAS TH', url: new URL('/', Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={title} description={description} image={image} type="article" schema={schema}>
  <main class="section">
    <article class="wrap prose">
      <div class="eyebrow">แหล่งปลูกทั่วโลก · Brazil</div>
      <h1>กาแฟบราซิล Cerrado Jaguar: ช็อกโกแลต ถั่ว และสัมผัสครีมมี่</h1>
      <p class="lede">กาแฟบราซิลที่เข้าถึงง่าย บอดี้เต็ม และยังคงรสช็อกโกแลตชัดเมื่อชงเป็น Espresso หรือกาแฟนม</p>
      <div class="article-meta">โดย พี่หยวน BREW ATLAS TH · อัปเดต 11 กันยายน 2569 · อ่านประมาณ 8 นาที</div>

      <img class="article-hero" src={image} alt="กาแฟบราซิล Cerrado Jaguar พร้อมธงชาติบราซิลสีน้ำ เมล็ดกาแฟ ช็อกโกแลต และถั่ว" width="1536" height="864" fetchpriority="high" />

      <section class="quick-summary" aria-labelledby="cerrado-summary">
        <div class="eyebrow">สรุปใน 30 วินาที</div>
        <h2 id="cerrado-summary">หวานนุ่ม ดื่มง่าย และเข้ากับนม</h2>
        <div class="summary-grid">
          <div><strong>แหล่งปลูก</strong><span>Cerrado, Minas Gerais, Brazil</span></div>
          <div><strong>ความสูงของภูมิภาค</strong><span>ประมาณ 800–1,300 เมตร</span></div>
          <div><strong>โปรไฟล์สินค้า</strong><span>Milky Chocolate · Nutty · Creamy</span></div>
          <div><strong>เหมาะกับ</strong><span>Espresso, Americano และกาแฟนม</span></div>
        </div>
      </section>

      <nav class="toc" aria-label="สารบัญบทความ">
        <strong>อ่านตามหัวข้อ</strong>
        <ol>
          <li><a href="#region">Cerrado คือแหล่งปลูกแบบไหน</a></li>
          <li><a href="#name">Cerrado, Cerrado Mineiro และ Jaguar</a></li>
          <li><a href="#flavor">รสชาติและกระบวนการ</a></li>
          <li><a href="#roast-brew">ระดับคั่วและสูตรชง</a></li>
          <li><a href="#recommended">ดูสินค้า Cerrado Jaguar</a></li>
        </ol>
      </nav>

      <h2 id="region">Cerrado คือแหล่งปลูกแบบไหน</h2>
      <p>Cerrado Mineiro เป็นภูมิภาคกาแฟทางตะวันตกเฉียงเหนือของรัฐ Minas Gerais พื้นที่ปลูกอยู่สูงประมาณ <strong>800–1,300 เมตรเหนือระดับน้ำทะเล</strong> มีฤดูกาลค่อนข้างชัด—ฤดูร้อนมีฝน ส่วนฤดูหนาวแห้งกว่า สภาพอากาศช่วงเก็บเกี่ยวจึงเอื้อต่อการตากและควบคุมความชื้นของเมล็ด</p>
      <p>ภูมิภาคนี้เป็นที่รู้จักด้านการผลิตที่สม่ำเสมอ การใช้เทคโนโลยี และการตรวจสอบย้อนกลับ กาแฟ Cerrado จึงมักถูกเลือกเป็นฐานของ Espresso และ Blend ที่ต้องการความหวาน บอดี้ และรสชาติซึ่งทำซ้ำได้ง่าย</p>

      <h2 id="name">อ่านชื่อบนถุงให้ถูกก่อนเลือกซื้อ</h2>
      <div class="name-grid">
        <article><span>01</span><h3>Brazil Cerrado</h3><p>บอกประเทศและภูมิภาคแหล่งปลูกในความหมายกว้าง ยังไม่ยืนยันการรับรอง DO</p></article>
        <article><span>02</span><h3>Cerrado Mineiro DO</h3><p>อยู่ภายใต้ขอบเขตและหลักเกณฑ์ Designation of Origin ที่ตรวจสอบย้อนกลับได้</p></article>
        <article><span>03</span><h3>Jaguar</h3><p>ในบทความนี้คือชื่อสินค้าหรือล็อตของผู้คั่ว ไม่ใช่ชื่อสายพันธุ์หรือใบรับรองโดยอัตโนมัติ</p></article>
      </div>
      <aside class="callout"><strong>สิ่งที่ควรตรวจบนหน้าร้าน:</strong> ระดับคั่วจริง ขนาดบรรจุ Process วันที่คั่ว และตัวเลือกการบด เพราะคำว่า Cerrado เพียงคำเดียวไม่สามารถอธิบายกาแฟทุกล็อตได้</aside>

      <h2 id="flavor">ทำไมช็อกโกแลตและบอดี้จึงเด่น</h2>
      <p>กาแฟจาก Cerrado มักถูกอธิบายด้วยช็อกโกแลต ถั่ว คาราเมล น้ำตาลทรายแดง และบอดี้ที่นุ่มหรือเต็ม โปรไฟล์นี้เกิดจากสายพันธุ์ ภูมิอากาศ ความสุก วิธีแปรรูป และการคั่วร่วมกัน ไม่ใช่จากแหล่งปลูกเพียงปัจจัยเดียว</p>

      <div class="flavor-strip" aria-label="โปรไฟล์รสชาติ Cerrado Jaguar">
        <div><strong>กลิ่น</strong><span>ช็อกโกแลตนม · ถั่วคั่ว</span></div>
        <div><strong>ความหวาน</strong><span>คาราเมล · น้ำตาลทรายแดง</span></div>
        <div><strong>บอดี้</strong><span>กลางถึงเต็ม · Creamy</span></div>
        <div><strong>ฟินิช</strong><span>โกโก้ · ถั่ว · หวานนุ่ม</span></div>
      </div>

      <p>คำว่า <strong>Nutty</strong> อาจชวนให้นึกถึงอัลมอนด์ เฮเซลนัต หรือถั่วคั่ว ส่วน <strong>Creamy</strong> อธิบายเนื้อสัมผัส ไม่ได้หมายความว่ามีการเติมนมหรือครีมลงในเมล็ด และ Tasting Notes ทั้งหมดเป็นภาษาชี้นำประสบการณ์ ไม่ใช่ส่วนผสม</p>

      <h3>Process ที่พบได้ในกาแฟบราซิล</h3>
      <div class="table-scroll" tabindex="0" role="region" aria-label="เปรียบเทียบกระบวนการกาแฟบราซิล">
        <table>
          <thead><tr><th>กระบวนการ</th><th>บุคลิกที่มักพบ</th><th>แนวทางการชง</th></tr></thead>
          <tbody>
            <tr><td>Natural</td><td>หวานเข้ม บอดี้มาก และอาจมีผลไม้สุก</td><td>Espresso หรือกาแฟดำที่ต้องการเนื้อสัมผัส</td></tr>
            <tr><td>Washed</td><td>สะอาด มีความเป็นกรด และแยกโน้ตง่าย</td><td>Drip เพื่อสำรวจรายละเอียด</td></tr>
            <tr><td>Honey / Pulped Natural</td><td>หวานและมีบอดี้ พร้อมความใสระดับหนึ่ง</td><td>ใช้ได้ทั้ง Drip และ Espresso</td></tr>
          </tbody>
        </table>
      </div>
      <p>สินค้าที่แนะนำระบุข้อมูล Process ในหน้าร้านทั้งคำว่า Pulped Natural และ Natural จึงควรตรวจรายละเอียดของตัวเลือกหรือล็อตล่าสุดบน Shopee ก่อนสั่งซื้อ</p>

      <h2 id="roast-brew">เลือกระดับคั่วและวิธีชง</h2>
      <div class="brew-grid">
        <article><div class="eyebrow">Medium</div><h3>คั่วกลาง</h3><p>รักษาความหวานและสมดุลระหว่างช็อกโกแลต ถั่ว และความเป็นกรด เหมาะกับ Drip, Americano และ Espresso</p></article>
        <article><div class="eyebrow">Medium–Dark</div><h3>คั่วกลางเข้มถึงเข้ม</h3><p>ดันโกโก้ ถั่วคั่ว คาราเมล และบอดี้ให้เด่น เหมาะกับ Espresso, Moka Pot และกาแฟนม</p></article>
      </div>

      <section class="recipes" aria-labelledby="recipes-title">
        <div class="eyebrow">สูตรตั้งต้น</div>
        <h3 id="recipes-title">เริ่มง่าย แล้วปรับจากรสที่ได้</h3>
        <div>
          <p><strong>Drip:</strong> กาแฟ 15 กรัม · น้ำ 240 กรัม · 92–94°C · เวลารวมประมาณ 2:45–3:30 นาที</p>
          <p><strong>Espresso:</strong> กาแฟ 18 กรัม · น้ำกาแฟ 36 กรัม · ประมาณ 25–32 วินาที</p>
        </div>
        <p>หากเบาและเปรี้ยวเกินไป ให้บดละเอียดขึ้นหรือเพิ่มอุณหภูมิ หากขมและแห้ง ให้บดหยาบขึ้นหรือลดอุณหภูมิ โดยเฉพาะคั่วเข้มควรเริ่มจากน้ำที่เย็นกว่าคั่วกลางเล็กน้อย</p>
      </section>

      <h2 id="recommended">Cerrado Jaguar ที่ Brew Atlas TH คัดสรร</h2>
      {product ? (
        <aside class="product-pick" aria-label="สินค้า Brazil Cerrado Jaguar แนะนำ">
          <a class="pick-image" href={`/products/${product.slug}`}><img src={product.image} alt={`${product.brand} ${product.name}`} width="700" height="700" loading="lazy" /></a>
          <div class="pick-copy">
            <div class="eyebrow">{product.brand} · {product.roast}</div>
            <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
            <p>{product.summary}</p>
            <div class="tags">{product.notes.map(note => <span>{note}</span>)}</div>
            <div class="pick-actions">
              <a class="btn" href={`/go/${product.slug}?utm_campaign=guide-cerrado-jaguar`} rel="sponsored nofollow">ดูราคาและตัวเลือกบน Shopee</a>
              <a class="text-link" href={`/products/${product.slug}`}>อ่านรายละเอียด →</a>
            </div>
          </div>
        </aside>
      ) : (
        <p class="notice">สินค้ากำลังอยู่ระหว่างการอัปเดต กรุณากลับมาตรวจสอบอีกครั้ง</p>
      )}
      <p class="affiliate-note">ลิงก์ไปยัง Shopee เป็น Affiliate Link หากสั่งซื้อผ่านลิงก์ BREW ATLAS TH อาจได้รับค่าคอมมิชชัน โดยราคาไม่เพิ่มขึ้นสำหรับคุณ</p>

      <h2>เหมาะกับใคร</h2>
      <p>Cerrado Jaguar เหมาะกับผู้เริ่มต้น คนที่ไม่ชอบความเปรี้ยวจัด ผู้ชง Espresso ที่บ้าน และคนที่ต้องการกาแฟประจำวันสำหรับ Americano หรือเมนูนม หากคุณชอบดอกไม้ ผลไม้สด หรือความเป็นกรดสูง ควรเลือกคั่วอ่อนและตรวจโปรไฟล์ของล็อตให้ละเอียดขึ้น</p>

      <h2>สรุป: กาแฟบราซิลที่ดื่มง่ายและใช้งานได้กว้าง</h2>
      <p>จุดเด่นของ Cerrado Jaguar ตามข้อมูลผลิตภัณฑ์คือ <strong>Milky Chocolate, Nutty, Creamy และ Full Body</strong> ชื่อบนถุงช่วยบอกทิศทาง แต่ Process ระดับคั่ว วันที่คั่ว และวิธีชงจะเป็นตัวกำหนดประสบการณ์จริง เริ่มจากคั่วกลางหากอยากสำรวจความหวาน หรือขยับไปคั่วเข้มหากต้องการโกโก้และบอดี้ที่หนักแน่นขึ้น</p>

      <section class="references" aria-labelledby="references-title">
        <h2 id="references-title">แหล่งข้อมูล</h2>
        <ol>
          <li><a href="/products/roast-lab-bkk-brazil-cerrado-jaguar">BREW ATLAS TH — Brazil Cerrado Jaguar</a></li>
          <li><a href="https://www.allycoffee.com/coffees/pau-brasil-cerrado-certified/" rel="noopener noreferrer">Ally Coffee — Paubrasil, Cerrado Certified</a></li>
          <li><a href="https://ineffablecoffee.com/en/blogs/origin-monographics/cafe-de-brasil" rel="noopener noreferrer">Ineffable Coffee — All About Brazilian Coffee</a></li>
          <li><a href="https://www.cerradomineiro.org/index.php?language=en" rel="noopener noreferrer">Região do Cerrado Mineiro — Official Regional Organization</a></li>
        </ol>
        <p><small>ผู้เขียน: พี่หยวน BREW ATLAS TH · เนื้อหาเป็นแนวทาง รสชาติจริงขึ้นอยู่กับล็อต ระดับคั่ว ความสด น้ำ และวิธีชง</small></p>
      </section>
    </article>
  </main>

  <style>
    .quick-summary{background:var(--espresso);color:var(--cream);padding:28px 30px;margin:0 0 28px}.quick-summary .eyebrow{color:var(--latte)}.quick-summary h2{font-size:2rem;margin:.25em 0 1em}.summary-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(255,255,255,.16)}.summary-grid div{display:flex;flex-direction:column;background:var(--espresso);padding:15px 18px}.summary-grid strong{color:#efd7b4}.summary-grid span{font-size:.86rem;color:#d8c9b7}.name-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0}.name-grid article{border:1px solid var(--line);padding:19px}.name-grid span{color:var(--latte);font:700 1rem var(--serif)}.name-grid h3{font:700 1.15rem var(--serif);margin:.3em 0}.name-grid p{font-size:.8rem;color:var(--muted);margin:0}.flavor-strip{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin:24px 0}.flavor-strip div{display:flex;flex-direction:column;background:var(--cream);padding:17px}.flavor-strip strong{color:var(--coffee)}.flavor-strip span{font-size:.84rem;color:var(--muted)}.table-scroll{overflow-x:auto;margin:24px 0;border:1px solid var(--line)}.table-scroll table{min-width:650px;margin:0;border:0}.brew-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:24px 0}.brew-grid article{background:var(--cream);border-top:3px solid var(--coffee);padding:21px}.brew-grid h3{font:700 1.28rem var(--serif);margin:.35em 0}.brew-grid p{font-size:.84rem;color:var(--muted);margin:0}.recipes{border:1px solid var(--line);border-left:4px solid var(--forest);padding:24px;margin:28px 0}.recipes h3{font:700 1.45rem var(--serif);margin:.35em 0}.recipes>div:not(.eyebrow){display:grid;grid-template-columns:1fr 1fr;gap:16px}.product-pick{display:grid;grid-template-columns:230px 1fr;background:linear-gradient(135deg,#f8f4ec,#ead9bf);border:1px solid var(--line);overflow:hidden;margin:24px 0}.pick-image{background:#fff}.pick-image img{width:100%;height:100%;min-height:310px;object-fit:contain}.pick-copy{padding:25px;display:flex;flex-direction:column}.pick-copy h3{font:700 1.4rem/1.2 var(--serif);margin:.35em 0}.pick-copy p{color:var(--muted)}.tags span{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:3px 8px;margin:2px;font-size:.68rem;background:#fff}.pick-actions{display:flex;align-items:center;gap:16px;margin-top:auto}.pick-actions .btn{padding:9px 13px}.affiliate-note{font-size:.78rem;color:var(--muted)}.references{border-top:1px solid var(--line);margin-top:56px;padding-top:12px}.references h2{font-size:1.8rem}.references a{color:var(--coffee);text-decoration:underline;text-underline-offset:3px}
    @media(max-width:700px){.prose h1{font-size:clamp(2rem,10vw,2.45rem);line-height:1.08}.article-hero{width:100%;height:auto;max-height:none;object-fit:contain;margin:20px 0 28px}.quick-summary{padding:22px}.quick-summary h2{font-size:1.6rem}.summary-grid,.name-grid,.flavor-strip,.brew-grid,.recipes>div:not(.eyebrow){grid-template-columns:1fr}.product-pick{grid-template-columns:115px 1fr}.pick-image img{min-height:255px}.pick-copy{padding:16px}.pick-copy h3{font-size:1.05rem}.pick-copy p{font-size:.78rem}.pick-actions{align-items:flex-start;flex-direction:column;gap:7px}.pick-actions .btn{font-size:.7rem;padding:8px}.table-scroll{margin-inline:-4vw;border-left:0;border-right:0}}
  </style>
</BaseLayout>
